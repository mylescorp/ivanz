{
  "name": "ivanz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-admin.mjs && next dev",
    "admin:sync": "node scripts/sync-admin.mjs",
    "admin:seed-owner": "node scripts/seed-owner.mjs",
    "build": "npm run admin:build && node scripts/sync-admin.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy --yes",
    "convex:sync-prod-auth": "node scripts/sync-convex-prod-auth-env.mjs",
    "admin:dev": "npm run dev --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "postinstall": "npm install --prefix admin --no-audit --no-fund"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.93",
    "@hookform/resolvers": "^3.9.1",
    "clsx": "^2.1.1",
    "convex": "^1.40.0",
    "lucide-react": "^0.462.0",
    "next": "16.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
}
